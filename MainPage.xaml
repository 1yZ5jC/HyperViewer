<Page
    x:Class="HyperViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperViewer"
    xmlns:controls="using:HyperViewer.Controls"
    xmlns:models="using:HyperViewer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <!-- 缩略图栏当前项高亮 -->
        <Style x:Key="ThumbBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" IsOpen="False">
            <CommandBar.Content>
                <TextBlock Text="HyperViewer"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </CommandBar.Content>
            <AppBarButton Icon="OpenFile" Label="打开图片" Command="{x:Bind Vm.OpenImageCommand}"/>
            <AppBarButton Icon="Folder" Label="打开文件夹" Command="{x:Bind Vm.OpenFolderCommand}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Previous" Label="上一张"
                          Command="{x:Bind Vm.PrevCommand}"
                          IsEnabled="{x:Bind Vm.CanGoPrev, Mode=OneWay}"/>
            <AppBarButton Icon="Next" Label="下一张"
                          Command="{x:Bind Vm.NextCommand}"
                          IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Rotate" Label="旋转" Command="{x:Bind Vm.RotateCommand}"/>
            <AppBarButton Label="水平翻转" Command="{x:Bind Vm.FlipHCommand}"/>
            <AppBarButton Label="垂直翻转" Command="{x:Bind Vm.FlipVCommand}"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="SlideShowButton"
                          Icon="Play"
                          Label="{x:Bind Vm.SlideShowLabel, Mode=OneWay}"
                          Command="{x:Bind Vm.ToggleSlideShowCommand}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Page" Label="全屏" Click="ToggleFullScreen_Click"/>
        </CommandBar>

        <Grid Grid.Row="1" Background="Black">
            <controls:ImageViewer x:Name="Viewer"
                                  Source="{x:Bind Vm.DisplayImage, Mode=OneWay}"
                                  ImageRotation="{x:Bind Vm.Rotation, Mode=OneWay}"
                                  FlipH="{x:Bind Vm.FlipH, Mode=OneWay}"
                                  FlipV="{x:Bind Vm.FlipV, Mode=OneWay}"/>

            <!-- 加载中 -->
            <ProgressRing x:Name="LoadingRing"
                          IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                          Width="48"
                          Height="48"
                          Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 加载失败 -->
            <StackPanel x:Name="FailedPanel"
                        Visibility="{x:Bind Vm.LoadFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⚠ 图片加载失败"
                           FontSize="20"
                           Foreground="#FFFF6060"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind Vm.Current.Path, Mode=OneWay, FallbackValue=''}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Foreground="#FFA0A0A0"
                           HorizontalAlignment="Center"
                           MaxWidth="600"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 空态 -->
            <TextBlock Text="⚠ 未打开图片&#x0a;点击顶部“打开图片”或“打开文件夹”开始"
                       x:Name="EmptyHint"
                       Foreground="#CCFFFFFF"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Grid>

        <!-- 缩略图栏 -->
        <Grid Grid.Row="2"
              Height="100"
              Background="#FF1A1A1A"
              Visibility="{x:Bind Vm.ThumbnailVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="最近"
                    Background="#FF2D2D2D"
                    BorderBrush="#FF3D3D3D"
                    BorderThickness="0"
                    Padding="12,0"
                    Foreground="White"
                    Click="RecentButton_Click"
                    VerticalAlignment="Stretch"
                    FontSize="13"/>
            <ListView x:Name="ThumbList"
                      Grid.Column="1"
                      ItemsSource="{x:Bind Vm.Photos, Mode=OneWay}"
                      SelectionChanged="ThumbList_SelectionChanged"
                      IsItemClickEnabled="False"
                      Padding="4,0"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoItem">
                        <Border Width="90" Height="90"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="0"
                                Background="#FF2D2D2D">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="UniformToFill"
                                   Width="86"
                                   Height="86"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="3" Background="#FF1F1F1F" Padding="12,6">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Foreground="#FFCCCCCC"
                       FontSize="13"/>
        </Border>
    </Grid>
</Page>
