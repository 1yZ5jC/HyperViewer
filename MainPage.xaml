<Page
    x:Class="HyperViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperViewer"
    xmlns:controls="using:HyperViewer.Controls"
    xmlns:models="using:HyperViewer.Models"
    xmlns:storage="using:Windows.Storage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <!-- 缩略图栏当前项高亮 -->
        <Style x:Key="ThumbBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" IsOpen="False">
            <CommandBar.Content>
                <TextBlock Text="HyperViewer"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </CommandBar.Content>
            <AppBarButton Icon="OpenFile" x:Uid="CmdOpenImage" Command="{x:Bind Vm.OpenImageCommand}"/>
            <AppBarButton Icon="Folder" x:Uid="CmdOpenFolder" Command="{x:Bind Vm.OpenFolderCommand}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Previous" x:Uid="CmdPrev"
                          Command="{x:Bind Vm.PrevCommand}"
                          IsEnabled="{x:Bind Vm.CanGoPrev, Mode=OneWay}"/>
            <AppBarButton Icon="Next" x:Uid="CmdNext"
                          Command="{x:Bind Vm.NextCommand}"
                          IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="SlideShowButton"
                          Icon="Play"
                          Label="{x:Bind Vm.SlideShowLabel, Mode=OneWay}"
                          Command="{x:Bind Vm.ToggleSlideShowCommand}"/>
            <AppBarButton x:Uid="CmdEdit" IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                          Click="EditButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Uid="CmdMore">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem x:Uid="MenuRotate">
                            <MenuFlyoutItem x:Uid="MenuRotateCW" Command="{x:Bind Vm.RotateCommand}"/>
                            <MenuFlyoutItem x:Uid="MenuRotateCCW" Command="{x:Bind Vm.RotateBackCommand}"/>
                            <MenuFlyoutItem x:Uid="MenuRotate180" Command="{x:Bind Vm.Rotate180Command}"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Uid="MenuFlipH" Command="{x:Bind Vm.FlipHCommand}"/>
                        <MenuFlyoutItem x:Uid="MenuFlipV" Command="{x:Bind Vm.FlipVCommand}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="MenuInfo" Command="{x:Bind Vm.ToggleInfoPanelCommand}"/>
                        <MenuFlyoutItem x:Uid="MenuFavorite"
                                        Command="{x:Bind Vm.ToggleFavoriteCommand}"/>
                        <MenuFlyoutItem x:Uid="MenuTimeline" Click="TimelineButton_Click"
                                        IsEnabled="{x:Bind Vm.CanOpenTimeline, Mode=OneWay}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="CmdDelete" Click="Delete_Click"
                                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                        <MenuFlyoutItem x:Uid="CmdRename" Click="Rename_Click"
                                        IsEnabled="{x:Bind Vm.CanRenameCurrent, Mode=OneWay}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="MenuFullScreen" Click="ToggleFullScreen_Click"/>
                        <MenuFlyoutItem x:Uid="MenuSettings" Click="SettingsButton_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" Background="{x:Bind Vm.MainBackground, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"
                                  x:Name="InfoColumn"/>
            </Grid.ColumnDefinitions>

            <!-- 主图区 -->
            <Grid Grid.Column="0" Background="Black">
                <controls:ImageViewer x:Name="Viewer"
                                      Source="{x:Bind Vm.DisplayImage, Mode=OneWay}"
                                      ImageRotation="{x:Bind Vm.Rotation, Mode=OneWay}"
                                      FlipH="{x:Bind Vm.FlipH, Mode=OneWay}"
                                      FlipV="{x:Bind Vm.FlipV, Mode=OneWay}"/>

                <!-- 加载中 -->
                <ProgressRing x:Name="LoadingRing"
                              IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                              Width="48"
                              Height="48"
                              Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <!-- 加载失败 -->
                <StackPanel x:Name="FailedPanel"
                            Visibility="{x:Bind Vm.LoadFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="StatusLoadFailed" FontSize="20"
                               Foreground="#FFFF6060"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Vm.Current.Path, Mode=OneWay, FallbackValue=''}"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Foreground="#FFA0A0A0"
                               HorizontalAlignment="Center"
                               MaxWidth="600"
                               TextWrapping="Wrap"/>
                </StackPanel>

                </Grid>

            <!-- 主页 (无图片时的欢迎面板) -->
            <Grid Grid.Column="0"
                  Background="#E6101010"
                  Visibility="{x:Bind Vm.HomeVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HomeStack.Padding" Value="16,16"/>
                                <Setter Target="HomeTitle.FontSize" Value="28"/>
                                <Setter Target="HomeSub.FontSize" Value="13"/>
                                <Setter Target="HomeSub.Margin" Value="0,8,0,0"/>
                                <Setter Target="HomeButtons.Orientation" Value="Vertical"/>
                                <Setter Target="HomeButtons.Margin" Value="0,22,0,0"/>
                                <Setter Target="HomeOpenBtn.Padding" Value="24,12"/>
                                <Setter Target="HomeOpenBtn.MinWidth" Value="0"/>
                                <Setter Target="HomeOpenBtn.HorizontalAlignment" Value="Stretch"/>
                                <Setter Target="HomeFolderBtn.Padding" Value="24,12"/>
                                <Setter Target="HomeFolderBtn.MinWidth" Value="0"/>
                                <Setter Target="HomeFolderBtn.Margin" Value="0,12,0,0"/>
                                <Setter Target="HomeFolderBtn.HorizontalAlignment" Value="Stretch"/>
                                <Setter Target="RecentSection.Margin" Value="0,26,0,0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="720"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel x:Name="HomeStack"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="960"
                            Padding="32,28">
                    <TextBlock x:Name="HomeTitle" Text="HyperViewer"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HomeSub" x:Uid="HomeSubtitle"
                               FontSize="15"
                               Foreground="#FFB0B0B0"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <StackPanel x:Name="HomeButtons"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">
                        <Button x:Name="HomeOpenBtn"
                                x:Uid="HomeOpenImage"
                                Command="{x:Bind Vm.OpenImageCommand}"
                                Padding="32,14"
                                MinWidth="190"
                                FontSize="16"
                                Background="#FF3D7FEA"
                                Foreground="White"
                                BorderThickness="0"/>
                        <Button x:Name="HomeFolderBtn"
                                x:Uid="HomeOpenFolder"
                                Command="{x:Bind Vm.OpenFolderCommand}"
                                Padding="32,14"
                                MinWidth="190"
                                FontSize="16"
                                Margin="14,0,0,0"
                                Background="#FF2D2D2D"
                                Foreground="White"
                                BorderThickness="1"
                                BorderBrush="#FF4A4A4A"/>
                    </StackPanel>
                    <StackPanel x:Name="RecentSection" Margin="0,40,0,0"
                                Visibility="{x:Bind Vm.RecentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Uid="HomeRecent"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD0D0D0"/>
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{x:Bind Vm.RecentFolders, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="storage:StorageFolder">
                                        <Button Tag="{x:Bind}"
                                                Click="HomeRecent_Click"
                                                Margin="0,0,12,0"
                                                Padding="16,14"
                                                MinWidth="210"
                                                Background="#FF2A2A2A"
                                                BorderThickness="1"
                                                BorderBrush="#FF3D3D3D"
                                                HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Path}"
                                                           FontSize="11"
                                                           Foreground="#FF909090"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 信息侧边栏 -->
            <Border Grid.Column="1"
                    x:Name="InfoPanel"
                    Background="#FF1F1F1F"
                    Visibility="{x:Bind Vm.InfoPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10" Background="#FF2A2A2A">
                        <TextBlock x:Uid="InfoPanelTitle"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                    </Border>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind Vm.InfoRows, Mode=OneWay}"
                              Padding="0,4"
                              Background="#FF1F1F1F"
                              IsItemClickEnabled="False"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:InfoRow">
                                <Grid Background="Transparent" Padding="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Key, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#FFA0A0A0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Value, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 缩略图栏 -->
        <Grid Grid.Row="2"
              Height="100"
              Background="#FF1A1A1A"
              Visibility="{x:Bind Vm.ThumbnailVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Uid="RecentMenu"
                    Background="#FF2D2D2D"
                    BorderBrush="#FF3D3D3D"
                    BorderThickness="0"
                    Padding="12,0"
                    Foreground="White"
                    Click="RecentButton_Click"
                    VerticalAlignment="Stretch"
                    FontSize="13"/>
            <ListView x:Name="ThumbList"
                      Grid.Column="1"
                      ItemsSource="{x:Bind Vm.Photos, Mode=OneWay}"
                      SelectionChanged="ThumbList_SelectionChanged"
                      IsItemClickEnabled="False"
                      Padding="4,0"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoItem">
                        <Border Width="90" Height="90"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="0"
                                Background="#FF2D2D2D">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="UniformToFill"
                                   Width="86"
                                   Height="86"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="3" Background="#FF1F1F1F" Padding="12,6">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Foreground="#FFCCCCCC"
                       FontSize="13"/>
        </Border>
    </Grid>
</Page>
