<Page
    x:Class="HyperViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperViewer"
    xmlns:controls="using:HyperViewer.Controls"
    xmlns:models="using:HyperViewer.Models"
    xmlns:storage="using:Windows.Storage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- 缩略图栏当前项高亮 -->
        <Style x:Key="ThumbBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="2"/>
       </Style>
        <!-- Pill 形 Tab 按钮样式 (Win11 Photos 风格) -->
        <Style x:Key="TabPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentBrush}"/>
                                       </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                       </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                       </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                       </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="FocusRing"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="14"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                       </Border>
                   </ControlTemplate>
               </Setter.Value>
           </Setter>
       </Style>
        <!-- 标题栏图标按钮样式 (Win11 Photos 风格, 已迁至 App.xaml 全局, 编辑页等复用) -->
        <!-- 视图布局资源: 项目宽高 -->
        <ItemsPanelTemplate x:Key="AlbumPanelWide">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="220"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="AlbumPanelNarrow">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="160"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoPanelWide">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="150"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoPanelNarrow">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="110" ItemHeight="110"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoPanelLargeWide">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="240"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoPanelLargeNarrow">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="165"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoCardPanelWide">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="190"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PhotoCardPanelNarrow">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="120" ItemHeight="150"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="DayFlowPanel">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="110" ItemHeight="110"/>
       </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WaterfallPanel">
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="150"/>
       </ItemsPanelTemplate>
        <!-- 照片缩略图网格项样式 (全部照片各视图共用: 悬停高亮 + 选中角标) -->
        <Style x:Key="PhotoGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                            <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                            <Setter Target="ContentBorder.Opacity" Value="0.9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusBorder.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="ContentBorder.BorderThickness" Value="3"/>
                                            <Setter Target="CheckBadge.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="FocusBorder"
                                    BorderBrush="{ThemeResource AccentBrush}"
                                    BorderThickness="2"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="CheckBadge"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,4,0"
                                    Background="{ThemeResource AccentBrush}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE73E;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="White"/>
                            </Border>
                            <Border x:Name="ContentBorder"
                                    Background="{ThemeResource CardBgBrush}"
                                    BorderBrush="{ThemeResource BtnBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="3">
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 右键/长按上下文菜单 -->
        <MenuFlyout x:Key="AlbumContextFlyout">
            <MenuFlyoutItem Text="打开" Click="AlbumContext_Open_Click"/>
            <MenuFlyoutItem Text="在文件夹中显示" Click="AlbumContext_OpenFolder_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="重命名" Click="AlbumContext_Rename_Click"/>
            <MenuFlyoutItem Text="删除" Click="AlbumContext_Delete_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="属性" Click="AlbumContext_Properties_Click"/>
        </MenuFlyout>
        <MenuFlyout x:Key="PhotoContextFlyout">
            <MenuFlyoutItem Text="打开" Click="PhotoContext_Open_Click"/>
            <MenuFlyoutItem Text="在文件夹中显示" Click="PhotoContext_OpenFolder_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="复制路径" Click="PhotoContext_CopyPath_Click"/>
            <MenuFlyoutItem Text="重命名" Click="PhotoContext_Rename_Click"/>
            <MenuFlyoutItem Text="删除" Click="PhotoContext_Delete_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="属性" Click="PhotoContext_Properties_Click"/>
        </MenuFlyout>
        <MenuFlyout x:Key="FolderContextFlyout">
            <MenuFlyoutItem Text="打开" Click="FolderContext_Open_Click"/>
            <MenuFlyoutItem Text="移除" Click="FolderContext_Remove_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="属性" Click="FolderContext_Properties_Click"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AlbumsGrid.ItemsPanel" Value="{StaticResource AlbumPanelWide}" />
                        <Setter Target="AllPhotosGrid.ItemsPanel" Value="{StaticResource PhotoPanelWide}" />
                        <Setter Target="FavoritesGrid.ItemsPanel" Value="{StaticResource PhotoPanelWide}" />
                        <Setter Target="PhotoLargeGrid.ItemsPanel" Value="{StaticResource PhotoPanelLargeWide}" />
                        <Setter Target="PhotoCardsGrid.ItemsPanel" Value="{StaticResource PhotoCardPanelWide}" />
                        <Setter Target="FileNameText.MaxWidth" Value="280" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AlbumsGrid.ItemsPanel" Value="{StaticResource AlbumPanelNarrow}" />
                        <Setter Target="AllPhotosGrid.ItemsPanel" Value="{StaticResource PhotoPanelNarrow}" />
                        <Setter Target="FavoritesGrid.ItemsPanel" Value="{StaticResource PhotoPanelNarrow}" />
                        <Setter Target="PhotoLargeGrid.ItemsPanel" Value="{StaticResource PhotoPanelLargeNarrow}" />
                        <Setter Target="PhotoCardsGrid.ItemsPanel" Value="{StaticResource PhotoCardPanelNarrow}" />
                        <Setter Target="FileNameText.MaxWidth" Value="160" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="AlbumsGrid.ItemsPanel" Value="{StaticResource AlbumPanelNarrow}" />
                        <Setter Target="AllPhotosGrid.ItemsPanel" Value="{StaticResource PhotoPanelNarrow}" />
                        <Setter Target="FavoritesGrid.ItemsPanel" Value="{StaticResource PhotoPanelNarrow}" />
                        <Setter Target="PhotoLargeGrid.ItemsPanel" Value="{StaticResource PhotoPanelLargeNarrow}" />
                        <Setter Target="PhotoCardsGrid.ItemsPanel" Value="{StaticResource PhotoCardPanelNarrow}" />
                        <Setter Target="FileNameText.MaxWidth" Value="100" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

                <Grid Grid.Row="0" Background="{x:Bind Vm.MainBackground, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"
                                  x:Name="InfoColumn"/>
            </Grid.ColumnDefinitions>

            <!-- 主图区 -->
            <Grid x:Name="ImageArea" Grid.Column="0"
                  Tapped="ImageArea_Tapped"
                  PointerMoved="ImageArea_PointerMoved">
                <controls:ImageViewer x:Name="Viewer"
                                      Source="{x:Bind Vm.DisplayImage, Mode=OneWay}"
                                      IsPlaceholder="{x:Bind Vm.IsQuickShowing, Mode=OneWay}"
                                      ImageRotation="{x:Bind Vm.Rotation, Mode=OneWay}"
                                      FlipH="{x:Bind Vm.FlipH, Mode=OneWay}"
                                      FlipV="{x:Bind Vm.FlipV, Mode=OneWay}"
                                      Background="{x:Bind Vm.MainBackground, Mode=OneWay}"/>

                <!-- 加载中 -->
                <ProgressRing x:Name="LoadingRing"
                              IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                              Width="48"
                              Height="48"
                              Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <!-- 加载失败 -->
                <StackPanel x:Name="FailedPanel"
                            Visibility="{x:Bind Vm.LoadFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE783;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="48"
                              Foreground="{ThemeResource ErrorTextBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="StatusLoadFailed"
                               FontSize="20"
                               Margin="0,8,0,0"
                               Foreground="{ThemeResource ErrorTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Vm.Current.Path, Mode=OneWay, FallbackValue=''}"
                               FontSize="12"
                               Margin="0,4,0,16"
                               Foreground="{ThemeResource DimTextBrush}"
                               HorizontalAlignment="Center"
                               MaxWidth="600"
                               TextWrapping="Wrap"/>
                    <Button x:Name="RetryButton"
                            x:Uid="LoadFailedRetry"
                            Click="Retry_Click"
                            HorizontalAlignment="Center"
                            Padding="20,8"
                            MinWidth="120"
                            Background="{ThemeResource BtnBgBrush}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource BtnBorderBrush}"/>
               </StackPanel>

                <!-- 幻灯片进度条 -->
                <Border Height="3"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource BtnBgBrush}"
                        Opacity="0.9"
                        Visibility="{x:Bind Vm.SlideShowRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Value="{x:Bind Vm.SlideShowProgress, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="1"
                                 Height="3"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{ThemeResource AccentBrush}"/>
                </Border>

                <!-- 中央悬停导航箭头 -->
                <Border x:Name="PrevArrow"
                        Width="48" Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Background="{ThemeResource NavArrowBgBrush}"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Button Command="{x:Bind Vm.PrevCommand}"
                            IsEnabled="{x:Bind Vm.CanGoPrev, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="上一张">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                    </Button>
                </Border>
                <Border x:Name="NextArrow"
                        Width="48" Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        Background="{ThemeResource NavArrowBgBrush}"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Button Command="{x:Bind Vm.NextCommand}"
                            IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="下一张">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                    </Button>
                </Border>
            </Grid>

            <!-- 主页 (图库视图: Tab 切换 集锦/全部照片/文件夹) -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource PanelBgBrush}"
                  Visibility="{x:Bind Vm.HomeVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部 48px 为标题栏占位 (HomeTopBar 已移到 TitleBarHost) -->

                <!-- 内容: 三个 Tab 视图 + 空态 -->
                <Grid Grid.Row="1">
                    <!-- 集锦 Tab: 相册卡片网格 -->
 <GridView x:Name="AlbumsGrid" ItemsSource="{x:Bind Vm.Albums, Mode=OneWay}"
                              Visibility="{x:Bind Vm.AlbumsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="AlbumGrid_ItemClick"
                              RightTapped="AlbumsGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsPanel="{StaticResource AlbumPanelWide}">
                        <GridView.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </GridView.Transitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                                <Setter Target="ContentBorder.Opacity" Value="0.9"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="FocusStates">
                                                        <VisualState x:Name="Focused">
                                                            <VisualState.Setters>
                                                                <Setter Target="FocusBorder.Visibility" Value="Visible"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Unfocused"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="FocusBorder"
                                                        BorderBrush="{ThemeResource AccentBrush}"
                                                        BorderThickness="2"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="ContentBorder"
                                                        Background="{ThemeResource CardBgBrush}"
                                                        BorderBrush="{ThemeResource BtnBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="4">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumItem">
                                <Grid>
                                    <Grid>
                                        <ProgressRing x:Name="CoverLoadingRing"
                                                      IsActive="True"
                                                      Width="32"
                                                      Height="32"
                                                      Visibility="Visible"
                                                      Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        <Image x:Name="CoverImage"
                                               Source="{Binding Cover, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               Margin="0,0,0,44"
                                               Loaded="CoverImage_Loaded"
                                               ImageOpened="CoverImage_ImageOpened"
                                               ImageFailed="CoverImage_ImageFailed"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom" Padding="10,10">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0">
                                            <Run Text="{x:Bind Count}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind DateRangeText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 全部照片 Tab 容器: 顶部视图切换栏 + 各视图内容 -->
                    <Grid x:Name="AllPhotosHost"
                          Visibility="{x:Bind Vm.AllPhotosVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 视图模式切换栏 (网格/列表/大图/卡片/瀑布流/日期流/日历), 窄窗口可横向滑动 -->
                        <Border Grid.Row="0"
                                Margin="16,6,16,8"
                                Padding="2,2"
                                Background="{ThemeResource PanelBgBrush}"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource BtnBorderBrush}"
                                BorderThickness="1">
                        <ScrollViewer
                                      HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Uid="LibViewGrid"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="Grid"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoGridViewVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoGridViewVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="网格视图"
                                        AutomationProperties.Name="网格视图"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewList"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="List"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoListViewVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoListViewVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="列表视图"
                                        AutomationProperties.Name="列表视图"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewLargeGrid"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="LargeGrid"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoLargeGridVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoLargeGridVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="大图视图"
                                        AutomationProperties.Name="大图视图"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewCards"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="Cards"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoCardsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoCardsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="卡片视图"
                                        AutomationProperties.Name="卡片视图"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewWaterfall"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="Waterfall"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoWaterfallVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoWaterfallVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="瀑布流"
                                        AutomationProperties.Name="瀑布流"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewDayFlow"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="DayFlow"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoDayFlowVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoDayFlowVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="日期流"
                                        AutomationProperties.Name="日期流"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,2,0">
                                    <FontIcon Glyph="&#xE8BF;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <Button x:Uid="LibViewCalendar"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Command="{x:Bind Vm.SelectPhotoViewCommand}"
                                        CommandParameter="Calendar"

                                        Padding="0"

                                        Background="{x:Bind Vm.PhotoCalendarVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                        Foreground="{x:Bind Vm.PhotoCalendarVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                                        ToolTipService.ToolTip="日历热力图"
                                        AutomationProperties.Name="日历热力图"
                                        Width="40"
                                        Height="40"
                                        Margin="2,0,0,0">
                                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                    <!-- 全部照片 Tab: 缩略图网格 -->
                    <GridView x:Name="AllPhotosGrid" ItemsSource="{x:Bind Vm.AllPhotos, Mode=OneWay}"
                              Grid.Row="1"
                              Visibility="{x:Bind Vm.PhotoGridViewVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PhotoGrid_ItemClick"
                              SelectionChanged="AllPhotosGrid_SelectionChanged"
                              RightTapped="AllPhotosGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsPanel="{StaticResource PhotoPanelWide}">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                                <Setter Target="ContentBorder.Opacity" Value="0.9"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="FocusStates">
                                                        <VisualState x:Name="Focused">
                                                            <VisualState.Setters>
                                                                <Setter Target="FocusBorder.Visibility" Value="Visible"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Unfocused"/>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="3"/>
                                                                <Setter Target="CheckBadge.Visibility" Value="Visible"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="FocusBorder"
                                                        BorderBrush="{ThemeResource AccentBrush}"
                                                        BorderThickness="2"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="CheckBadge"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,4,4,0"
                                                        Background="{ThemeResource AccentBrush}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False">
                                                    <FontIcon Glyph="&#xE73E;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="12"
                                                              Foreground="White"/>
                                                </Border>
                                                <Border x:Name="ContentBorder"
                                                        Background="{ThemeResource CardBgBrush}"
                                                        BorderBrush="{ThemeResource BtnBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="3">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Loaded="PhotoThumbnail_Loaded"
                                       DataContextChanged="PhotoImage_DataContextChanged"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 全部照片: 列表视图 (缩略图 + 名称 + 日期) -->
                    <ListView x:Name="PhotoListView"
                              ItemsSource="{x:Bind Vm.AllPhotos, Mode=OneWay}"
                              Grid.Row="1"
                              Visibility="{x:Bind Vm.PhotoListViewVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,4,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PhotoGrid_ItemClick"
                              RightTapped="AllPhotosGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Grid Margin="0,2" Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="8"
                                            Background="{ThemeResource CardBgBrush}"
                                            BorderBrush="{ThemeResource BtnBorderBrush}"
                                            BorderThickness="1"
                                            Padding="2">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               Loaded="PhotoThumbnail_Loaded"
                                               DataContextChanged="PhotoImage_DataContextChanged"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DateCreatedText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE8A7;"
                                              FontSize="13"
                                              Foreground="{ThemeResource TextMutedBrush}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 全部照片: 大图网格 -->
                    <GridView x:Name="PhotoLargeGrid"
                              ItemsSource="{x:Bind Vm.AllPhotos, Mode=OneWay}"
                              Grid.Row="1"
                              Visibility="{x:Bind Vm.PhotoLargeGridVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PhotoGrid_ItemClick"
                              RightTapped="AllPhotosGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{StaticResource PhotoGridItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Loaded="PhotoThumbnail_Loaded"
                                       DataContextChanged="PhotoImage_DataContextChanged"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 全部照片: 详情卡片网格 (图 + 名称 + 日期) -->
                    <GridView x:Name="PhotoCardsGrid"
                              ItemsSource="{x:Bind Vm.AllPhotos, Mode=OneWay}"
                              Grid.Row="1"
                              Visibility="{x:Bind Vm.PhotoCardsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PhotoGrid_ItemClick"
                              RightTapped="AllPhotosGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{StaticResource PhotoGridItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <StackPanel>
                                    <Border Height="128"
                                            Background="{ThemeResource CardBgBrush}"
                                            Padding="3">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               Loaded="PhotoThumbnail_Loaded"
                                               DataContextChanged="PhotoImage_DataContextChanged"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,6,4,0"/>
                                    <TextBlock Text="{x:Bind DateCreatedText}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               Margin="4,2,4,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 全部照片: 瀑布流 (按宽高比跨格: 横图 2 列宽, 竖图 2 行高) -->
                    <GridView x:Name="PhotoWaterfallGrid"
                              ItemsSource="{x:Bind Vm.AllPhotos, Mode=OneWay}"
                              Grid.Row="1"
                              Visibility="{x:Bind Vm.PhotoWaterfallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PhotoGrid_ItemClick"
                              RightTapped="AllPhotosGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsPanel="{StaticResource WaterfallPanel}"
                              ItemContainerStyle="{StaticResource PhotoGridItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Loaded="PhotoThumbnail_Loaded"
                                       DataContextChanged="PhotoImage_DataContextChanged"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 全部照片: 日期分组流 (按日期降序 + 组头) -->
                    <Grid x:Name="DayFlowHost"
                          Grid.Row="1"
                          Visibility="{x:Bind Vm.PhotoDayFlowVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 日期过滤提示条 (日历点击后显示) -->
                        <Border x:Name="DayFilterBar"
                                Grid.Row="0"
                                Margin="16,4,16,4"
                                Padding="12,6"
                                CornerRadius="10"
                                Background="{ThemeResource CardBgBrush}"
                                BorderBrush="{ThemeResource BtnBorderBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind Vm.FilterDayActive, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Vm.FilterDayText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Uid="DayFlowClear"
                                        Style="{StaticResource TextButtonStyle}"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        Background="{ThemeResource BtnBgBrush}"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Command="{x:Bind Vm.ClearDayFilterCommand}"/>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="DayFlowList"
                                  Grid.Row="1"
                                  Padding="16,0,16,16"
                                  ItemsSource="{x:Bind Vm.DayFlowGroups, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="PhotoGrid_ItemClick"
                                  RightTapped="AllPhotosGrid_RightTapped"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PhotoDayGroup">
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Margin="0,6,0,6" Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextMutedBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="10,0,0,2"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="110" ItemHeight="110"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PhotoItem">
                                                    <Border Margin="3"
                                                            Padding="2"
                                                            CornerRadius="10"
                                                            Background="{ThemeResource CardBgBrush}"
                                                            BorderBrush="{ThemeResource BtnBorderBrush}"
                                                            BorderThickness="1"
                                                            Tapped="DayFlowPhoto_Tapped">
                                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               Loaded="PhotoThumbnail_Loaded"
                                                               DataContextChanged="PhotoImage_DataContextChanged"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 全部照片: 日历热力图 (月份块, 色阶=当日照片数, 点击某天筛选) -->
                    <ScrollViewer x:Name="CalendarHost"
                                  Grid.Row="1"
                                  Visibility="{x:Bind Vm.PhotoCalendarVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                  Padding="16,8,16,16"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind Vm.CalendarMonths, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CalendarMonth">
                                    <Border Margin="6"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBgBrush}"
                                            BorderBrush="{ThemeResource BtnBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       Margin="2,0,0,8"/>
                                            <ItemsControl ItemsSource="{x:Bind Weekdays}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="36" ItemHeight="22"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{x:Bind}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                                   TextAlignment="Center"
                                                                   Width="36"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{x:Bind Days}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="36" ItemHeight="36" MaximumRowsOrColumns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CalendarDay">
                                                        <Border Width="32"
                                                                Height="32"
                                                                Margin="2"
                                                                CornerRadius="8"
                                                                Background="{x:Bind Fill}"
                                                                Tapped="CalendarDay_Tapped">
                                                            <TextBlock Text="{x:Bind DayNumberText}"
                                                                       FontSize="11"
                                                                       Foreground="{x:Bind TextBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>

                    <!-- 收藏 Tab: 缩略图网格 (可拖拽排序) -->
                    <GridView x:Name="FavoritesGrid" ItemsSource="{x:Bind Vm.Favorites, Mode=OneWay}"
                              Visibility="{x:Bind Vm.FavoritesContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Padding="16,0,16,16"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              CanReorderItems="True"
                              AllowDrop="True"
                              ItemClick="PhotoGrid_ItemClick"
                              RightTapped="FavoritesGrid_RightTapped"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsPanel="{StaticResource PhotoPanelWide}">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="ContentBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                                                <Setter Target="ContentBorder.BorderThickness" Value="2"/>
                                                                <Setter Target="ContentBorder.Opacity" Value="0.9"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="FocusStates">
                                                        <VisualState x:Name="Focused">
                                                            <VisualState.Setters>
                                                                <Setter Target="FocusBorder.Visibility" Value="Visible"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Unfocused"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="FocusBorder"
                                                        BorderBrush="{ThemeResource AccentBrush}"
                                                        BorderThickness="2"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="ContentBorder"
                                                        Background="{ThemeResource CardBgBrush}"
                                                        BorderBrush="{ThemeResource BtnBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="3">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Loaded="PhotoThumbnail_Loaded"
                                       DataContextChanged="PhotoImage_DataContextChanged"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 文件夹 Tab: 文件夹列表 -->
                    <ScrollViewer x:Name="FoldersGrid" Visibility="{x:Bind Vm.FoldersContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                  Padding="16,0,16,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Click="AddFolder_Click"
                                    Padding="14,8"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    AutomationProperties.Name="添加文件夹">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    <TextBlock x:Uid="LibAddFolderTxt"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        <ItemsControl ItemsSource="{x:Bind Vm.RecentFolders, Mode=OneWay}">
<ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="storage:StorageFolder">
                                    <Button Tag="{x:Bind}"
                                            Click="HomeRecent_Click"
                                            RightTapped="RecentFolder_RightTapped"
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            MinWidth="280"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border CornerRadius="12"
                                                Background="{ThemeResource CardBgBrush}"
                                                BorderBrush="{ThemeResource BtnBorderBrush}"
                                                BorderThickness="1"
                                                Padding="16,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xE8B7;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="24"
                                                          Foreground="{ThemeResource AccentBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Path}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="FolderMetaText"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextMutedBrush}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空态: 欢迎面板 -->
                    <Border Visibility="{x:Bind Vm.LibraryEmptyVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560"
                            Background="{ThemeResource PanelBgBrush}"
                            CornerRadius="16"
                            Padding="48,40">
                        <Border.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                           </TransitionCollection>
                       </Border.Transitions>
                        <StackPanel>
                            <!-- 大图标 (Win11 Photos 风格) -->
                            <Border Width="72" Height="72"
                                    CornerRadius="36"
                                    Background="{ThemeResource BtnBgBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="32"
                                          Foreground="{ThemeResource AccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                           </Border>
                            <TextBlock Text="HyperViewer"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>
                            <TextBlock x:Uid="HomeSubtitle"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,28,0,0">
                                <Button x:Uid="HomeOpenImage"
                                        Command="{x:Bind Vm.OpenImageCommand}"
                                        Style="{StaticResource AccentTextButtonStyle}"
                                        Padding="24,10"
                                        MinWidth="160"
                                        FontSize="13"
                                        Background="{ThemeResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"/>
                                <Button x:Uid="HomeOpenFolder"
                                        Command="{x:Bind Vm.OpenFolderCommand}"
                                        Style="{StaticResource TextButtonStyle}"
                                        Padding="24,10"
                                        MinWidth="160"
                                        FontSize="13"
                                        Margin="12,0,0,0"
                                        Background="{ThemeResource BtnBgBrush}"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource BtnBorderBrush}"/>
                           </StackPanel>
                       </StackPanel>
                   </Border>
                </Grid>
            </Grid>

            <!-- 信息侧边栏 -->
<Border Grid.Column="1"
                    x:Name="InfoPanel"
                    Background="{ThemeResource ChromeBgBrush}"
                    Visibility="{x:Bind Vm.InfoPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
    <Grid>
                        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10" Background="{ThemeResource ChromeBgAltBrush}">
                        <TextBlock x:Uid="InfoPanelTitle"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                    </Border>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind Vm.InfoRows, Mode=OneWay}"
                              Padding="0,4"
                              Background="{ThemeResource ChromeBgBrush}"
                              IsItemClickEnabled="False"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:InfoRow">
                                <Grid Background="Transparent" Padding="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Key, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Value, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Padding="8,6"
                            Background="{ThemeResource ChromeBgAltBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="InfoHistogramTitle"
                                       Grid.Row="0"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"/>
                            <Image x:Name="HistogramImage"
                                   Grid.Row="1"
                                   Width="280"
                                   Height="80"
                                   Stretch="Uniform"
                                   Source="{x:Bind Vm.HistogramImage, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 批量选择操作条 -->
            <Border x:Name="SelectBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    CornerRadius="12"
                    Background="{ThemeResource TopBarBgBrush}"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectCountText"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="4,0,10,0"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <Button x:Name="SelectFavBtn"
                            Click="SelectFav_Click"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="批量收藏">
                        <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <Button x:Name="SelectShareBtn"
                            Click="SelectShare_Click"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="批量分享">
                        <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <Button x:Name="SelectDeleteBtn"
                            Click="SelectDelete_Click"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="批量删除">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <Button x:Name="SelectCancelBtn"
                            Click="SelectCancel_Click"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            AutomationProperties.Name="取消选择">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 缩略图栏 -->
        <Grid x:Name="ThumbBar" Grid.Row="1"
              Height="92"
              Background="{ThemeResource ChromeBgStrongBrush}"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Uid="RecentMenu"
                    Background="{ThemeResource BtnBgBrush}"
                    BorderBrush="{ThemeResource BtnBorderBrush}"
                    BorderThickness="0"
                    Padding="12,0"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Click="RecentButton_Click"
                    VerticalAlignment="Stretch"
                    FontSize="13"/>
            <Grid Grid.Column="1">
                <ListView x:Name="ThumbList"
                      ItemsSource="{x:Bind Vm.Photos, Mode=OneWay}"
                      SelectionChanged="ThumbList_SelectionChanged"
                      IsItemClickEnabled="False"
                      Padding="4,0"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
              </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                  </Style>
              </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoItem">
                        <Border Width="80" Height="80"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="0"
                                Background="{ThemeResource BtnBgBrush}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="UniformToFill"
                                   Width="76"
                                   Height="76"
                                   Loaded="PhotoThumbnail_Loaded"
                                   DataContextChanged="PhotoImage_DataContextChanged"/>
                      </Border>
                  </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
                <!-- 手动卷动按钮: 半透明圆钮叠在胶片左右两侧, 按 0.8 视口宽卷动
                     (10240 的 Button 无 CornerRadius, 用 Border 包按钮, 同导航箭头模式) -->
                <Border Width="32" Height="32"
                        CornerRadius="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Background="{ThemeResource NavArrowBgBrush}">
                    <Button x:Name="ThumbScrollLeft"
                            Click="ThumbScrollLeft_Click"
                            Width="32" Height="32"
                            MinWidth="0" MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.Name="胶片向左卷动">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"/>
                    </Button>
                </Border>
                <Border Width="32" Height="32"
                        CornerRadius="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Background="{ThemeResource NavArrowBgBrush}">
                    <Button x:Name="ThumbScrollRight"
                            Click="ThumbScrollRight_Click"
                            Width="32" Height="32"
                            MinWidth="0" MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsTabStop="False"
                            AutomationProperties.Name="胶片向右卷动">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"/>
                    </Button>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="2" Background="{ThemeResource ChromeBgBrush}" Padding="12,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Vm.StatusLeftText, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Vm.StatusRightText, Mode=OneWay}"
                           Foreground="{ThemeResource TextMutedBrush}"
                           FontSize="13"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider"
                        Grid.Column="2"
                        Minimum="10"
                        Maximum="800"
                        StepFrequency="1"
                        Width="140"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                <!-- 适应窗口 -->
                <Button x:Name="FitBtn"
                        Grid.Column="3"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Click="Fit_Click"
                        Margin="12,0,0,0"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                        ToolTipService.ToolTip="适应"
                        AutomationProperties.Name="适应">
                    <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 缩略图栏开关 -->
                <Button x:Name="ThumbToggleBtn"
                        Grid.Column="4"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Click="ThumbToggle_Click"
                        Margin="12,0,0,0"
                        IsEnabled="{x:Bind Vm.ThumbnailVisible, Mode=OneWay}"
                        ToolTipService.ToolTip="隐藏缩略图"
                        AutomationProperties.Name="隐藏缩略图"
                        Background="{ThemeResource AccentBrush}"
                        Foreground="White">
                    <FontIcon Glyph="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- 标题栏集成顶栏 (Win11 Photos 风格): 声明在最后保证 Z 序最上层。
             拖拽层 TitleBarDragRegion 是唯一 SetTitleBar 目标 (官方示例模式:
             交互控件若位于 SetTitleBar 元素的子树内将收不到任何指针输入) -->
        <Grid x:Name="TitleBarHost"
              Grid.RowSpan="3"
              VerticalAlignment="Top"
              Height="48"
              Background="Transparent">

            <!-- 拖拽层 (Z 序最底, 透明背景可命中): 空白区域按住拖动 = 移动窗口 -->
            <Grid x:Name="TitleBarDragRegion" Background="Transparent"/>

            <!-- 图库顶栏: Tab + 搜索 + 操作按钮。无底色 (透明浮于内容上, 也不挡下方拖拽层);
                 按钮等控件在拖拽层之上, 可正常点击 -->
            <Grid x:Name="HomeTopBar"
                  Padding="0"
                  Visibility="{x:Bind Vm.HomeVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="SearchColumn" Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="HomePad" Width="0"/>
                </Grid.ColumnDefinitions>
                <!-- 应用名 (拖拽区域) -->
                <TextBlock x:Name="AppTitleText"
                           Grid.Column="0"
                           Text="HyperViewer"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,16,0"/>
                <!-- Tab 栏 (Pill 风格) -->
                <StackPanel x:Name="TabPanel" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TabAlbums" x:Uid="LibTabAlbums"
                            Style="{StaticResource TabPillButtonStyle}"
                            Command="{x:Bind Vm.SelectAlbumsTabCommand}"
                            Background="{x:Bind Vm.AlbumsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                            Foreground="{x:Bind Vm.AlbumsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                            AutomationProperties.Name="相册"
                            Margin="0,0,2,0"/>
                    <Button x:Name="TabAllPhotos" x:Uid="LibTabAllPhotos"
                            Style="{StaticResource TabPillButtonStyle}"
                            Command="{x:Bind Vm.SelectAllPhotosTabCommand}"
                            Background="{x:Bind Vm.AllPhotosVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                            Foreground="{x:Bind Vm.AllPhotosVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                            AutomationProperties.Name="全部照片"
                            Margin="0,0,2,0"/>
                    <Button x:Name="TabFolders" x:Uid="LibTabFolders"
                            Style="{StaticResource TabPillButtonStyle}"
                            Command="{x:Bind Vm.SelectFoldersTabCommand}"
                            Background="{x:Bind Vm.FoldersVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                            Foreground="{x:Bind Vm.FoldersVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                            AutomationProperties.Name="文件夹"/>
                    <Button x:Name="TabFavorites" x:Uid="LibTabFavorites"
                            Style="{StaticResource TabPillButtonStyle}"
                            Command="{x:Bind Vm.SelectFavoritesTabCommand}"
                            Background="{x:Bind Vm.FavoritesVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                            Foreground="{x:Bind Vm.FavoritesVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"
                            AutomationProperties.Name="收藏"
                            Margin="2,0,0,0"/>
                </StackPanel>
                <!-- 窄窗口溢出菜单 (Tab + 操作按钮收进 ... ) -->
                <Button x:Name="LibOverflowBtn"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Background="{ThemeResource BtnBgBrush}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        BorderThickness="0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="更多操作">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="LibTabAlbumsFlyout"
                                            Command="{x:Bind Vm.SelectAlbumsTabCommand}"
                                            Background="{x:Bind Vm.AlbumsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                            Foreground="{x:Bind Vm.AlbumsVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"/>
                            <MenuFlyoutItem x:Uid="LibTabAllPhotosFlyout"
                                            Command="{x:Bind Vm.SelectAllPhotosTabCommand}"
                                            Background="{x:Bind Vm.AllPhotosVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                            Foreground="{x:Bind Vm.AllPhotosVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"/>
                            <MenuFlyoutItem x:Uid="LibTabFoldersFlyout"
                                            Command="{x:Bind Vm.SelectFoldersTabCommand}"
                                            Background="{x:Bind Vm.FoldersVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                            Foreground="{x:Bind Vm.FoldersVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"/>
                            <MenuFlyoutItem x:Uid="LibTabFavoritesFlyout"
                                            Command="{x:Bind Vm.SelectFavoritesTabCommand}"
                                            Background="{x:Bind Vm.FavoritesVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Bg}"
                                            Foreground="{x:Bind Vm.FavoritesVisible, Mode=OneWay, Converter={StaticResource SelBrush}, ConverterParameter=Fg}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="LibOpenImageFlyout" Command="{x:Bind Vm.OpenImageCommand}"/>
                            <MenuFlyoutItem x:Uid="LibAddFolderFlyout" Command="{x:Bind Vm.OpenFolderCommand}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="LibSettingsFlyout" Click="SettingsButton_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <!-- 搜索框 (占星号列: 随窗口宽度伸缩, 实际宽度过窄时自动收起为按钮) -->
                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                MaxWidth="320"
                                MinWidth="90"
                                Margin="0,0,12,0"
                                PlaceholderText="搜索相册 / 照片"
                                Text="{x:Bind Vm.SearchText, Mode=TwoWay}"
                                QueryIcon="Find"
                                AutomationProperties.Name="搜索相册 / 照片"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen"
                                TextChanged="SearchBox_TextChanged"
                                KeyDown="SearchBox_KeyDown"
                                LostFocus="SearchBox_LostFocus">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}"/>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <!-- 搜索框过窄时收起为图标按钮 (UpdateSearchBarCollapse 自动切换) -->
                <Button x:Name="SearchBtn"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Margin="0,0,8,0"
                        Click="SearchBtn_Click"
                        ToolTipService.ToolTip="搜索"
                        AutomationProperties.Name="搜索">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 右侧操作按钮 -->
                <StackPanel x:Name="ActionPanel" Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="LibOpenImageBtn"
                            Command="{x:Bind Vm.OpenImageCommand}"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="14,7"
                            Background="{ThemeResource BtnBgBrush}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            BorderThickness="0"
                            FontSize="13"
                            AutomationProperties.Name="打开图片">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            <TextBlock x:Name="OpenImageTxt" x:Uid="LibOpenImageTxt"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibAddFolderBtn"
                            Command="{x:Bind Vm.OpenFolderCommand}"
                            Style="{StaticResource AccentTextButtonStyle}"
                            Padding="14,7" Margin="8,0,8,0"
                            Background="{ThemeResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="13"
                            AutomationProperties.Name="打开文件夹">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            <TextBlock x:Name="AddFolderTxt" x:Uid="LibAddFolderTxt"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibSettingsBtn"
                            Click="SettingsButton_Click"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="14,7" Margin="8,0,0,0"
                            Background="{ThemeResource BtnBgBrush}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            BorderThickness="0"
                            FontSize="13"
                            AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            <TextBlock x:Name="SettingsTxt" x:Uid="LibSettingsTxt"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectModeBtn"
                            Click="SelectModeBtn_Click"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="12,7" Margin="8,0,0,0"
                            Background="{ThemeResource BtnBgBrush}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            BorderThickness="0"
                            FontSize="13"
                            AutomationProperties.Name="选择">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            <TextBlock x:Name="SelectModeBtnText" Text="选择"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 图片顶栏: 返回 / 文件名 / 旋转 / 编辑 / 信息 / 收藏 / 更多 -->
            <Grid x:Name="ImageTopBar"
                  Visibility="{x:Bind Vm.HomeVisible, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="ImagePad" Width="0"/>
                </Grid.ColumnDefinitions>
                <!-- 背景 (视觉层, 不参与命中, 不挡拖拽层; 需跨满全部列) -->
                <Grid IsHitTestVisible="False" Background="{ThemeResource TopBarBgBrush}" Grid.ColumnSpan="9"/>
                <!-- 返回图库 -->
                <Button Grid.Column="0"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Click="BackToLibrary_Click"
                        Margin="8,5,0,5"
                        ToolTipService.ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 文件名 -->
                <TextBlock x:Name="FileNameText"
                           Grid.Column="1"
                           Text="{x:Bind Vm.Current.Name, Mode=OneWay, FallbackValue=''}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           Margin="12,0,0,0"/>
                <Grid Grid.Column="2"/>
                <!-- 旋转 -->
                <Button Grid.Column="3"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Command="{x:Bind Vm.RotateCommand}"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                        ToolTipService.ToolTip="旋转"
                        AutomationProperties.Name="旋转">
                    <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 编辑 -->
                <Button Grid.Column="4"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Click="EditButton_Click"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                        ToolTipService.ToolTip="编辑"
                        AutomationProperties.Name="编辑">
                    <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 信息 -->
                <Button Grid.Column="5"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Command="{x:Bind Vm.ToggleInfoPanelCommand}"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                        ToolTipService.ToolTip="信息"
                        AutomationProperties.Name="信息">
                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <!-- 收藏 -->
                <Button Grid.Column="6"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Command="{x:Bind Vm.ToggleFavoriteCommand}"
                        IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"
                        ToolTipService.ToolTip="收藏"
                        AutomationProperties.Name="收藏">
                    <FontIcon Glyph="{x:Bind Vm.FavoriteGlyph, Mode=OneWay}"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"/>
                </Button>
                <!-- 更多 -->
                <Button Grid.Column="7"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Margin="4,5,0,5"
                        ToolTipService.ToolTip="更多"
                        AutomationProperties.Name="更多">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="MenuOpenImage" Command="{x:Bind Vm.OpenImageCommand}"/>
                            <MenuFlyoutItem x:Uid="MenuOpenFolder" Command="{x:Bind Vm.OpenFolderCommand}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind Vm.SlideShowLabel, Mode=OneWay}"
                                            Command="{x:Bind Vm.ToggleSlideShowCommand}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Uid="MenuRotate">
                                <MenuFlyoutItem x:Uid="MenuRotateCW" Command="{x:Bind Vm.RotateCommand}"/>
                                <MenuFlyoutItem x:Uid="MenuRotateCCW" Command="{x:Bind Vm.RotateBackCommand}"/>
                                <MenuFlyoutItem x:Uid="MenuRotate180" Command="{x:Bind Vm.Rotate180Command}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Uid="MenuFlipH" Command="{x:Bind Vm.FlipHCommand}"/>
                            <MenuFlyoutItem x:Uid="MenuFlipV" Command="{x:Bind Vm.FlipVCommand}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="MenuTimeline" Click="TimelineButton_Click"
                                            IsEnabled="{x:Bind Vm.CanOpenTimeline, Mode=OneWay}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="MenuShare" Click="Share_Click"
                                            IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Uid="MenuSaveAs" Click="SaveAs_Click"
                                            IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Uid="MenuPrint" Click="Print_Click"
                                            IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="CmdDelete" Click="Delete_Click"
                                            IsEnabled="{x:Bind Vm.HasImage, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Uid="CmdRename" Click="Rename_Click"
                                            IsEnabled="{x:Bind Vm.CanRenameCurrent, Mode=OneWay}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="MenuFullScreen" Click="ToggleFullScreen_Click"/>
                            <MenuFlyoutItem x:Uid="MenuSettings" Click="SettingsButton_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
