<Page
    x:Class="HyperViewer.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HyperViewer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏: 返回 / 标题 / 扫描进度 -->
        <Grid Grid.Row="0" Padding="8,4" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click" Padding="10,4" x:Uid="BackToolTip">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="348"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 日历快速定位 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <CalendarView x:Name="Cal"
                              Width="320" Margin="8"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              SelectionMode="Single" IsTodayHighlighted="False"
                              MinDate="{x:Bind Vm.CalendarMin, Mode=OneWay}"
                              MaxDate="{x:Bind Vm.CalendarMax, Mode=OneWay}"
                              SelectedDatesChanged="Cal_SelectedDatesChanged"/>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <ListView x:Name="TimelineList"
                          ItemsSource="{x:Bind Vm.Groups, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="12,8"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TimelineGroup">
                            <StackPanel Margin="0,0,32,24">
                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,8"/>
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="128" ItemHeight="128"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PhotoItem">
                                                <Button Tag="{x:Bind}" Click="Photo_Click"
                                                        Padding="0" Background="Transparent" BorderThickness="0">
                                                    <Image Source="{x:Bind Thumbnail}" Width="120" Height="120" Stretch="UniformToFill"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyHint" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Uid="TimelineEmpty" FontSize="16"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>