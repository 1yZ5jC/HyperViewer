<Application
    x:Class="HyperViewer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperViewer"
    xmlns:helpers="using:HyperViewer.Helpers">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 深色板 (默认) - Win11 Photos 风格 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="ChromeBgBrush" Color="#FF202020"/>
                    <SolidColorBrush x:Key="ChromeBgAltBrush" Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="ChromeBgStrongBrush" Color="#FF181818"/>
                    <SolidColorBrush x:Key="TopBarBgBrush" Color="#CC202020"/>
                    <SolidColorBrush x:Key="PanelBgBrush" Color="#E6101010"/>
                    <SolidColorBrush x:Key="BtnBgBrush" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="BtnBgHoverBrush" Color="#FF383838"/>
                    <SolidColorBrush x:Key="BtnBorderBrush" Color="#FF4A4A4A"/>
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FF262626"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFCCCCCC"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF909090"/>
                    <!-- 半透明叠加 -->
                    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#80000000"/>
                    <!-- 错误/提示/导航 -->
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFF6060"/>
                    <SolidColorBrush x:Key="DimTextBrush" Color="#FFA0A0A0"/>
                    <SolidColorBrush x:Key="NavArrowBgBrush" Color="#A0000000"/>
                    <!-- 裁剪遮罩 -->
                    <SolidColorBrush x:Key="CropDimBrush" Color="#59000000"/>
                    <SolidColorBrush x:Key="CropLineBrush" Color="#33FFFFFF"/>
               </ResourceDictionary>
                <!-- 浅色板 - Win11 Photos 风格 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="ChromeBgBrush" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="ChromeBgAltBrush" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="ChromeBgStrongBrush" Color="#FFFAFAFA"/>
                    <SolidColorBrush x:Key="TopBarBgBrush" Color="#CCFAFAFA"/>
                    <SolidColorBrush x:Key="PanelBgBrush" Color="#E6F7F7F7"/>
                    <SolidColorBrush x:Key="BtnBgBrush" Color="#FFEDEDED"/>
                    <SolidColorBrush x:Key="BtnBgHoverBrush" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="BtnBorderBrush" Color="#FFBFBFBF"/>
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF444444"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF777777"/>
                    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#80000000"/>
                    <!-- 错误/提示/导航 -->
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB00020"/>
                    <SolidColorBrush x:Key="DimTextBrush" Color="#FF808080"/>
                    <SolidColorBrush x:Key="NavArrowBgBrush" Color="#A0000000"/>
                    <!-- 裁剪遮罩 -->
                    <SolidColorBrush x:Key="CropDimBrush" Color="#59000000"/>
                    <SolidColorBrush x:Key="CropLineBrush" Color="#33FFFFFF"/>
               </ResourceDictionary>
                <!-- 高对比度板 - 使用系统 HC 颜色 -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="ChromeBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="ChromeBgAltBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="ChromeBgStrongBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TopBarBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PanelBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="BtnBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="BtnBgHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="BtnBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CardBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="OverlayScrimBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <!-- 裁剪遮罩 -->
                    <SolidColorBrush x:Key="CropDimBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CropLineBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
               </ResourceDictionary>
           </ResourceDictionary.ThemeDictionaries>
<helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <helpers:SelectionBrushConverter x:Key="SelBrush"/>

            <!-- ====== 全局按钮样式 (圆角, Win11 Photos 风格; 10240 的 Button 无
                 CornerRadius, 圆角由自定义模板内的 Border 提供) ====== -->

            <!-- 标题栏图标按钮 (圆角 8) -->
            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource BtnBgBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.35"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="RootBorder" CornerRadius="8" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Border x:Name="FocusRing"
                                                BorderBrush="{ThemeResource AccentBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False"/>
                                        <ContentPresenter x:Name="ContentPresenter"
                                                          Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          FontSize="{TemplateBinding FontSize}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 文字按钮 (圆角 8, 顶栏/欢迎面板/编辑页通用) -->
            <Style x:Key="TextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource BtnBgBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.92"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="FocusRing"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 实心强调按钮 (圆角 8, AccentBrush 背景): TextButtonStyle 的 PointerOver 会把
                 前景变 AccentBrush (蓝底蓝字看不清), 这里 hover/按下只做变暗, 前景恒白 -->
            <Style x:Key="AccentTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.85"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.7"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="FocusRing"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 文字开关按钮 (圆角 8, 编辑页工具 Toggle 通用, 含 Checked 态) -->
            <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{ThemeResource BtnBgBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RootBorder"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.92"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="RootBorder.Opacity" Value="0.9"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource AccentBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="FocusRing"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
   </Application.Resources>
</Application>
